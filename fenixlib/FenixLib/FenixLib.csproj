<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Title>FenixLib</Title>
    <Description>.NET support for manipulating PixTudio, BennuGD, DivGO and DivDx native formats.</Description>
    <Authors>Darío Cutillas Carrillo</Authors>
    <Company>Darío Cutillas Carrillo</Company>
    <Copyright>Copyright © 2016 Darío Cutillas Carrillo</Copyright>
    <AssemblyTitle>$(Title)</AssemblyTitle>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dacucar/fenixlib</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>Game Bennu Graphics Fpg Font BitmapFont Editor</PackageTags>
    <PackageReleaseNotes>
    - Target .NET Standard 2.1 (Unity 6 / .NET 10 compatible).
    - Moved FenixLib.Core types to FenixLib namespace.
    - Removed FenixLib.Imaging.PixelWriter.
    - Fixed bugs in FenixLib.Imaging.PixelReader.
    </PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
    <None Include="../README.md" target="" Pack="true" PackagePath="/" />
    <None Include="../logo.png" target="" Pack="true" PackagePath="/" />
    <None Include="../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>  
</Project>
